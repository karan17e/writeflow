# Application Settings
PROJECT_NAME="WriteFlow API"
ENVIRONMENT="production"
DEBUG=False
PORT=8000
ALLOWED_ORIGINS="https://your-frontend-domain.com"

# Database
DATABASE_URL="sqlite+aiosqlite:///./linkedin_posts.db"

# LLM Configuration
# Options: groq, openai, gemini, anthropic, mock
LLM_PROVIDER="groq"

# API Keys (Set your provider key in production environment variables)
GROQ_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
